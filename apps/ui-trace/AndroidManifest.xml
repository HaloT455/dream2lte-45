<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="vn.alice.uitrace" android:versionCode="2" android:versionName="1.1">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application android:label="ALice UI Trace" android:icon="@drawable/ic_trace"
        android:theme="@style/AppTheme" android:allowBackup="false"
        android:debuggable="false" android:supportsRtl="true" android:usesCleartextTraffic="false">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name=".TraceService" android:exported="false"
            android:foregroundServiceType="dataSync" />
        <provider android:name=".LogProvider" android:authorities="vn.alice.uitrace.logs"
            android:exported="false" android:grantUriPermissions="true" />
    </application>
</manifest>
